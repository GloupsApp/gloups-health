{
  "name": "@gloups/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "test:cqrs": "tsc --project tsconfig.test.json && tsc-alias -p tsconfig.test.json --resolve-full-paths && node --test dist/tests/test/account-cqrs.test.js",
    "typecheck": "tsc --project tsconfig.json",
    "dev": "node --env-file=.env.local --watch dist/main.js",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local dist/migrate.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/expo": "1.7.14",
    "@gloups/contracts": "workspace:*",
    "@nestjs/common": "12.3.0",
    "@nestjs/core": "12.3.0",
    "@nestjs/cqrs": "12.1.2",
    "@nestjs/drizzle": "0.0.2",
    "@nestjs/platform-node": "12.3.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gloups/typescript-config": "workspace:*",
    "@gloups/ultracite-config": "workspace:*",
    "drizzle-kit": "0.31.11"
  },
  "engines": {
    "node": "26.12.1"
  }
}
