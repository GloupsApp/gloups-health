{
  "extends": "@gloups/typescript-config/nestjs.json",
  "compilerOptions": {
    "paths": {
      "@api/*": ["./src/*"],
      "@accounts/*": ["./src/modules/accounts/*"],
      "@authentication/*": ["./src/modules/authentication/*"],
      "@database/*": ["./src/database/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "drizzle.config.ts",
    "eslint.config.ts",
    "oxlint.config.ts"
  ]
}
