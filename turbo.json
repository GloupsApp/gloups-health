{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.paths.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", "generated/dist/**"],
      "env": ["EXPO_PUBLIC_API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["EXPO_PUBLIC_API_URL"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "//#check": {
      "cache": false
    },
    "//#fix": {
      "cache": false
    },
    "test:web": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": []
    }
  }
}
