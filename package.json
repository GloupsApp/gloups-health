{
  "name": "gloups-health",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && turbo run build",
    "dev": "turbo run dev --",
    "docs:build": "turbo run build --filter=@gloups/docs",
    "docs:dev": "turbo run dev --filter=@gloups/docs --",
    "docs:preview": "turbo run preview --filter=@gloups/docs --",
    "mobile:build": "turbo run build --filter=@gloups/mobile",
    "mobile:dev": "turbo run dev --filter=@gloups/mobile --",
    "mobile:ios": "turbo run dev --filter=@gloups/mobile -- --ios",
    "mobile:android": "turbo run dev --filter=@gloups/mobile -- --android",
    "check": "ultracite check",
    "typecheck": "tsc --project tsconfig.json && turbo run typecheck",
    "fix": "ultracite fix",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "api:build": "turbo run build --filter=@gloups/api",
    "api:start": "bun run --filter @gloups/api start",
    "api:watch": "bun run --filter @gloups/api watch",
    "e2e:api": "e2e run --target api"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "e2e": "0.21.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "ultracite": "8.1.0",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*": "ultracite fix"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.4"
}
