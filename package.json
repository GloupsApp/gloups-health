{
  "name": "gloups-health",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && turbo run build",
    "dev": "turbo run dev --",
    "docs:build": "turbo run build --filter=@gloups/docs",
    "docs:dev": "turbo run dev --filter=@gloups/docs --",
    "docs:preview": "turbo run preview --filter=@gloups/docs --",
    "mobile:build": "turbo run build --filter=@gloups/mobile",
    "mobile:dev": "turbo run dev --filter=@gloups/mobile --",
    "mobile:ios": "turbo run dev --filter=@gloups/mobile -- --ios",
    "mobile:android": "turbo run dev --filter=@gloups/mobile -- --android",
    "check": "ultracite check",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.json && tsc --project tools/tsconfig.json",
    "fix": "ultracite fix",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "api:build": "turbo run build --filter=@gloups/api",
    "api:start": "node --env-file=apps/api/.env.local apps/api/dist/main.js",
    "api:db:generate": "bun run --filter @gloups/api db:generate",
    "api:db:migrate": "node --env-file=apps/api/.env.local apps/api/dist/migrate.js",
    "api:mail-sink": "node tools/start-mail-sink.ts",
    "local:setup": "node tools/setup-local.ts",
    "contracts:build": "bun run --filter @gloups/contracts build",
    "contracts:generate": "bun run --filter @gloups/contracts generate",
    "contracts:check": "bun run contracts:generate && git diff --exit-code -- packages/contracts/generated",
    "check:boundaries": "node tools/check-boundaries.ts && node --test tools/architecture-checker.test.ts",
    "check:nest": "node --test tools/nest-doctor-policy.test.ts && node tools/check-nest-doctor.ts",
    "test:api": "bun run api:build && e2e run --config e2e/api/config.ts",
    "test:integration": "bun run test:api",
    "test:cqrs": "bun run --filter @gloups/api test:cqrs",
    "test:mobile:ios": "node tools/run-mobile.ts ios",
    "test:mobile:android": "node tools/run-mobile.ts android"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@e2e-dev/mobile": "0.12.4",
    "@gloups/contracts": "workspace:*",
    "@types/node": "24.19.2",
    "e2e": "0.21.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nestjs-doctor": "0.9.10",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsc-alias": "1.9.9",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "ultracite": "8.1.0",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*": "ultracite fix"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.4"
}
