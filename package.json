{
  "name": "gloups-health",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --",
    "docs:build": "turbo run build --filter=@gloups/docs",
    "docs:dev": "turbo run dev --filter=@gloups/docs --",
    "docs:preview": "turbo run preview --filter=@gloups/docs --",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "eslint-plugin-anti-slop": "0.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.10",
    "ultracite": "8.1.0"
  },
  "lint-staged": {
    "*": "ultracite fix"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.4"
}
