{
  "name": "@gloups/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json",
    "test:web": "bun test test/web.test.ts"
  },
  "devDependencies": {
    "@gloups/typescript-config": "workspace:*",
    "@gloups/ultracite-config": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-native-web": "0.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "0.21.4",
    "tsc-alias": "1.9.9",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  }
}
